server {
    listen 80;
    server_name _;

    # SPA shell. The HTML must revalidate on every load (no-cache) or
    # browsers serve the previous deploy's index.html from heuristic
    # cache and never pick up the new hashed bundle.
    location / {
        root /var/www/drivepod;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }

    # Content-hashed assets are immutable — cache for a year. Regex wins
    # over the plain prefix above; /api/ and /cache/ never match this.
    location ~* ^/(main|chunk|polyfills|runtime|styles)-[A-Za-z0-9_-]+\.(js|css)$ {
        root /var/www/drivepod;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Live playlist index — regenerated on every state change. MUST never be
    # cached (browser or proxy) or the queue shows a stale/inconsistent mix.
    # Exact-match wins over the /cache/ prefix block below; MP3s + thumbnails
    # keep their normal (cacheable) treatment.
    location = /cache/index.json {
        alias /home/lab/projects/DrivePod/cache/index.json;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        default_type application/json;
    }

    location /cache/ {
        alias /home/lab/projects/DrivePod/cache/;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header X-Content-Type-Options "nosniff" always;
        types {
            image/jpeg  jpg jpeg;
            image/png   png;
            image/webp  webp;
            image/gif   gif;
            audio/mpeg  mp3;
            application/json json;
        }
        default_type application/octet-stream;
    }
}