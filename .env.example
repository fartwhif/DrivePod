# Container-side paths, which must match docker-compose.yml's mount points
# (./data -> /data, ./cache -> /cache). The backend reads these from .env
# (baked into the image at build time and re-sourced by entrypoint.sh), and
# drivepod-ngnix refers to /cache directly.
CACHE_DIR=/cache
DATA_DIR=/data
DATABASE_URL="file:/data/database.db"

# ====== Network ======
VPS_IP=0.0.0.0
NGINX_PORT=24320
# WireGuard client config for the nginx container.
# Generated on the VPS: wg genkey | tee privatekey | wg pubkey
WG_PRIVATE_KEY=
# Container WireGuard address (assigned by VPS server config)
WG_ADDRESS=10.99.0.228/32
# DNS server inside the tunnel (optional)
WG_DNS=10.99.0.42



# VPS WireGuard server peer config
WG_PEER_PUBLIC_KEY=
# AllowedIPs: use the WG subnet (e.g. 10.99.0.0/20), NOT 0.0.0.0/0.
# Using /0 inside Docker causes routing loops — all traffic including WG control
# packets gets sent through wg0, breaking the connection.
WG_PEER_ALLOWEDIPS=10.99.0.0/20
# VPS public IP and WireGuard port
WG_PEER_ENDPOINT=X.X.X.X:51820
# Keepalive interval in seconds (keeps NAT mappings alive)
WG_PEER_PERSISTENT_KEEPALIVE=25
# ====== Cookie session liveness ======
# Vault state file that gates harvest and feeds the harvest tab's session badge
# ({"state":"up"|"down","ts":<epoch s>}). Blank = the mount default
# /shared-cookies/session-state.json, i.e. the ../ytcookies/data mount below.
# Set it whenever the cookie jar is relocated (COOKIES_FILE pointing elsewhere):
# the state file always lives beside the jar, and a reader aimed at a mount
# that isn't there reports "unknown" and never gates.
# COOKIE_SESSION_STATE=/shared-cookies/session-state.json
