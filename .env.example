CACHE_DIR=/path/to/drivepod/cache
DATA_DIR=/path/to/drivepod/data
DATABASE_URL="file:/path/to/drivepod/data/database.db"

# ====== Network ======
VPS_IP=0.0.0.0
NGINX_PORT=24320
# WireGuard client config for the nginx container.
# Generated on the VPS: wg genkey | tee privatekey | wg pubkey
WG_PRIVATE_KEY=
# Container WireGuard address (assigned by VPS server config)
WG_ADDRESS=192.168.0.228/32
# DNS server inside the tunnel (optional)
WG_DNS=192.168.0.42



# VPS WireGuard server peer config
WG_PEER_PUBLIC_KEY=
# AllowedIPs: use the WG subnet (e.g. 192.168.0.0/20), NOT 0.0.0.0/0.
# Using /0 inside Docker causes routing loops — all traffic including WG control
# packets gets sent through wg0, breaking the connection.
WG_PEER_ALLOWEDIPS=192.168.0.0/20
# VPS public IP and WireGuard port
WG_PEER_ENDPOINT=X.X.X.X:51820
# Keepalive interval in seconds (keeps NAT mappings alive)
WG_PEER_PERSISTENT_KEEPALIVE=25